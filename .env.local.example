# Copy this file to .env.local for local development (never commit .env.local).
# In production (Vercel), set the same variable under Project Settings -> Environment Variables.

# Resend API key, used by app/api/get-involved/route.ts to email form
# submissions. Get one free at https://resend.com — sign up using the same
# email address the submissions should be forwarded to
# (jonathonhopley@hotmail.com), so sending works immediately without
# verifying a custom domain.
RESEND_API_KEY=

# Copy to .env.local for local development (never commit .env.local).
# In production, set the same variable in the hosting provider's environment
# variables.

# OpenAI API key, used by app/api/assistant/route.ts to power the AI
# shopping-assistant greeter. Get one at https://platform.openai.com/api-keys.
# Without it, the assistant returns a clear 503 instead of failing silently.
OPENAI_API_KEY=
